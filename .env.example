# Copy this file to .env and fill in real values. Never commit .env itself.

# Used to sign staff login tokens. Set this to a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Creates the first staff login on first run (only used if no staff account exists yet).
ADMIN_SEED_EMAIL=admin@example.com
ADMIN_SEED_PASSWORD=change-this-password

# Optional: real email sending. If left blank, the server logs what it
# would have sent instead of actually sending anything, and bookings still
# work normally.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

PORT=4100
